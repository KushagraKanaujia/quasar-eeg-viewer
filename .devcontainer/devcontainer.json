{
  // Based on the official devcontainers/templates "python" template (MIT)
  "name": "Quasar EEG Viewer",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install --user -e '.[dev]' && python scripts/build_demo.py",
  "postAttachCommand": {
    "demo": "python -m http.server 8000 --directory site"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "EEG viewer demo",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}
